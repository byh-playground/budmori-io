{
    "name": "budmori-gamekit-checks",
    "private": true,
    "type": "module",
    "scripts": {
        "test": "node tests/smoke.e2e.mjs",
        "verify:upstream": "node scripts/gamekit-provenance.cjs refresh https://github.com/byh-playground/bloom-gamekit.git",
        "vector-assets:validate": "node scripts/vector-sources.cjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --max-warnings 0",
        "test:breed-allocation": "node tests/breed-allocation.e2e.mjs",
        "test:corn-growth": "for scenario in ui previews battle; do for viewport in desktop mobile; do timeout 180s node tests/corn-growth.e2e.mjs \"$scenario\" \"$viewport\" || exit $?; done; done; timeout 180s node tests/corn-growth.e2e.mjs battle landscape",
        "test:corn-growth:case": "node tests/corn-growth.e2e.mjs",
        "test:pea-growth:case": "node tests/pea-growth.e2e.mjs",
        "test:redbean-growth:case": "node tests/redbean-growth.e2e.mjs",
        "test:chestnut-growth:case": "node tests/chestnut-growth.e2e.mjs",
        "test:peanut-growth:case": "node tests/peanut-growth.e2e.mjs",
        "test:peanut-performance": "node tests/peanut-performance.e2e.mjs",
        "check": "npm run format:check && npm run lint && node scripts/ability-reference.mjs --check && node --check src/bootstrap.js && node --check src/farm-app.js && node --check src/vector-sockets.js && node --check src/features/unit-body/definition.js && node scripts/source-graph.mjs",
        "test:source-smoke": "node tests/source-smoke.e2e.mjs",
        "test:tower-army": "node tests/tower-army.e2e.mjs",
        "test:camera": "node tests/battle-camera.e2e.mjs",
        "test:scatter-command": "node tests/scatter-command.e2e.mjs",
        "test:scatter-participation": "node tests/scatter-participation.test.mjs",
        "test:hud-counts": "node tests/farm-hud-counts.test.mjs",
        "test:hud-sampling": "node tests/hud-sampling.e2e.mjs",
        "test:contact-boundaries": "node tests/contact-boundaries.test.mjs",
        "test:render-bounds": "node tests/render-visibility.test.mjs",
        "test:render-visibility": "node tests/render-visibility.e2e.mjs",
        "test:performance-optimizations": "node tests/performance-optimizations.e2e.mjs"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@xmldom/xmldom": "0.9.12",
        "esbuild": "0.28.2",
        "eslint": "10.13.0",
        "espree": "11.2.0",
        "globals": "16.5.0",
        "playwright": "1.63.0",
        "prettier": "3.9.10",
        "three": "0.186.1"
    },
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    }
}
