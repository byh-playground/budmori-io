{
  "name": "budmori-gamekit-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "npm run test:ability-tree && npm run test:progression && node scripts/test-scenarios.mjs all",
    "test:ability-tree": "node tests/ability-tree-unit.mjs && node tests/ability-tree-garden-unit.mjs",
    "test:browser:abilities": "node tests/ability-tree.e2e.mjs",
    "test:browser:raid-settlement": "node tests/raid-settlement.e2e.mjs",
    "test:progression": "node tests/farm-progression-unit.mjs && node tests/farm-boss-event-unit.mjs && node tests/raid-settlement-unit.mjs && node tests/raid-settlement-farm-unit.mjs",
    "test:farm-boss-event": "node tests/farm-boss-event-unit.mjs",
    "test:farm-recovery-indicators": "node tests/farm-recovery-indicators-unit.mjs",
    "test:browser:farm-recovery-indicators": "node tests/farm-recovery-indicators.e2e.mjs",
    "test:browser": "node scripts/test-scenarios.mjs core",
    "test:browser:save": "node scripts/test-scenarios.mjs save",
    "test:browser:victory": "node scripts/test-scenarios.mjs victory",
    "test:browser:multiplayer": "node scripts/test-scenarios.mjs network",
    "test:vector-assets": "node tests/vector-assets.e2e.mjs",
    "test:hungry-expression": "node tests/hungry-expression.e2e.mjs",
    "test:boss-visual": "node tests/boss-visual.e2e.mjs",
    "test:boss-armor": "node tests/boss-armor-unit.mjs",
    "test:unit-stats": "node tests/unit-stats-unit.mjs",
    "test:runtime-manifest": "npm run build && node tests/runtime-manifest-unit.mjs",
    "test:cold-boss": "node tests/cold-boss-startup.e2e.mjs",
    "test:mobile-input": "node tests/mobile-input.e2e.mjs",
    "verify:upstream": "node scripts/gamekit-provenance.cjs refresh https://github.com/byh-playground/bloom-gamekit.git",
    "verify:raid-load": "node tests/raid-load.mjs",
    "vector-assets:validate": "node scripts/vector-sources.cjs"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "three": "0.186.1"
  }
}
